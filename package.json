{
  "name": "check-all-reviewers-approved-action",
  "version": "1.0.0",
  "description": "GitHub Action to check whether all requested reviewers have approved a pull request",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "ncc build index.js --license licenses.txt",
    "prepare": "npm run build",
    "format": "prettier --write '**/*.{js,json,md,yml}'",
