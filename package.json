    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  }
}
